// $conf['storage']['params']['database'] = '';
// $conf['storage']['params']['charset'] = 'utf8mb4';
// $conf['storage']['params']['ssl'] = false;
$conf['storage']['params']['driverconfig'] = 'horde';

// ----------------------------------------------------------------------
// Data Types
// ----------------------------------------------------------------------
// Types
$conf['datatypes']['types'] = array('int', 'text', 'boolean', 'creditcard', 'cellphone', 'client', 'date', 'dblookup', 'description', 'email', 'enum', 'file', 'header', 'hourminutesecond', 'html', 'image', 'intlist', 'ipaddress', 'link', 'longtext', 'matrix', 'mlenum', 'monthdayyear', 'monthyear', 'multienum', 'number', 'obrowser', 'octal', 'password', 'radio', 'set', 'time');

// ----------------------------------------------------------------------
// Tickets
// ----------------------------------------------------------------------
